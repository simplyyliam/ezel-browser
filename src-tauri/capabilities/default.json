{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Full-window UI webview: core APIs (incl. events) and the browser commands. Tab webviews get no IPC.",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-hard-reload",
    "allow-stop-loading",
    "allow-open-devtools",
    "allow-copy-page-url",
    "allow-get-page",
    "allow-set-content-bounds",
    "allow-set-content-visible",
    "allow-set-content-radius",
    "allow-set-content-cutout",
    "allow-get-window-radius",
    "allow-get-tabs",
    "allow-open-tab",
    "allow-activate-tab",
    "allow-close-tab",
    "allow-remove-tab",
    "allow-reopen-closed-tab",
    "allow-unload-tab",
    "allow-cycle-tab",
    "allow-move-tab",
    "allow-reset-tab",
    "allow-update-pinned-url",
    "allow-clear-temp-tabs",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-set-folder-collapsed",
    "allow-move-folder",
    "allow-delete-folder",
    "allow-unload-folder",
    "allow-create-space",
    "allow-update-space",
    "allow-move-space",
    "allow-delete-space",
    "allow-switch-space",
    "allow-set-forwarded-hotkeys",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
