{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Toolbar UI webview: core APIs (incl. events) and the browser commands. The content webview gets no IPC.",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
